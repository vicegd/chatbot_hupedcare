import requests
import yaml

def cargar_config():
    with open("./config/config.yaml", "r") as f:
        return yaml.safe_load(f)

def chat():
    config = cargar_config()
    # Construimos la URL dinámicamente
    url = f"http://{config['server']['host']}:{config['server']['port']}/preguntar"
    
    print(f"Conectado al servidor en: {url}")
    
    while True:
        pregunta = input("Tú: ")
        if pregunta.lower() in ["salir", "exit"]: break
        
        try:
            response = requests.post(url, json={"pregunta": pregunta})
            if response.status_code == 200:
                print(f"\nIA: {response.json()['respuesta']}\n")
        except Exception as e:
            print(f"Error de conexión: {e}")

if __name__ == "__main__":
    chat()